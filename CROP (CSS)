body {
    font-family: 'Segoe UI', Arial, sans-serif;
    margin: 0;
    background-color: #f9f9f9;
}

nav {
    display: flex;
    justify-content: space-between;
    padding: 1rem 10%;
    background: #2d5a27;
    color: white;
}

nav ul { list-style: none; display: flex; }
nav ul li { margin-left: 20px; }
nav a { color: white; text-decoration: none; }

.container {
    max-width: 1000px;
    margin: 2rem auto;
    background: white;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
}

h2 { color: #2d5a27; }

.calc-box {
    display: flex;
    flex-direction: column;
    max-width: 500px;
}

/* Grey Input Styling */
input, select {
    margin: 8px 0 20px 0;
    padding: 12px;
    border-radius: 6px;
    border: 1px solid #ccc;
    background-color: #eeeeee; /* Grey Background */
    font-size: 1rem;
}

input:focus, select:focus {
    outline: 2px solid #2d5a27;
    background-color: #e2e2e2;
}

button {
    background: #444; /* Dark Grey Button */
    color: white;
    padding: 15px;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    background: #222;
}

/* Table Styling */
table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

th, td {
    text-align: left;
    padding: 12px;
    border-bottom: 1px solid #ddd;
}

th { background-color: #f2f2f2; }
