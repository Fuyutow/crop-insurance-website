<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AgriGuard | Farmer Dashboard</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <nav>
        <div class="logo">AgriGuard Insurance</div>
        <ul>
            <li><a href="#">Dashboard</a></li>
            <li><a href="#">Policies</a></li>
            <li><a href="#">Support</a></li>
        </ul>
    </nav>

    <main class="container">
        <section class="form-section">
            <h2>Register Your Crop</h2>
            <p>Fill in the details below to calculate your insurance and save to your profile.</p>
            
            <div class="calc-box">
                <label>Farmer Name</label>
                <input type="text" id="farmerName" placeholder="Enter full name">

                <label>Select Crop</label>
                <select id="cropType">
                    <option value="Wheat" data-price="500">Wheat ($500/Hectare)</option>
                    <option value="Rice" data-price="700">Rice ($700/Hectare)</option>
                    <option value="Corn" data-price="600">Corn ($600/Hectare)</option>
                    <option value="Soybeans" data-price="550">Soybeans ($550/Hectare)</option>
                </select>
                
                <label>Land Size (Hectares)</label>
                <input type="number" id="hectares" placeholder="Enter number of hectares">
                
                <button onclick="saveInformation()">Add to Records</button>
            </div>
        </section>

        <hr>

        <section class="records-section">
            <h2>Your Registered Crops</h2>
            <table id="recordsTable">
                <thead>
                    <tr>
                        <th>Farmer Name</th>
                        <th>Crop Type</th>
                        <th>Hectares</th>
                        <th>Total Value</th>
                        <th>Est. Premium</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    </tbody>
            </table>
        </section>
    </main>

    <script src="script.js"></script>
</body>
</html>
